{
  "name": "@aidoris/agent-daemon",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun dist/index.js"
  },
  "dependencies": {
    "@elysiajs/openapi": "catalog:",
    "elysia": "catalog:"
  },
  "devDependencies": {
    "@aidoris/ts-config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
